<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up / transfer only settings (DataStore: theme, signature, onboarding).
     Documents and the library database are excluded: PDFs can exceed the 25 MB backup quota (which
     disables backup entirely) and restored rows would point at files that weren't restored. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
