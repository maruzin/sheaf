<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Google Play Billing needs network access. Scanning/OCR run on-device; no CAMERA permission is
         required because the ML Kit document scanner runs in Google Play services' own UI. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nothing in Sheaf needs special hardware. Declared optional so Play doesn't hide the app from
         devices without it: touchscreen is otherwise assumed required (Chromebooks, keyboard/mouse
         devices), and the camera is only used by the scanner, which shows a message when absent. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- ML Kit's document scanner locks its helper activity to portrait, which makes Play infer
         android.hardware.screen.portrait as required (hiding Sheaf from landscape-only tablets,
         desktops and XR). Sheaf's own screens rotate freely, so declare it optional. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".SheafApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sheaf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sheaf">
            <!-- singleTask: one Sheaf screen. Every "Open with" / share reaches it through
                 onNewIntent, even for the same file again (standard mode stacked a new copy of the
                 app per file, and re-opening the task's own file only brought it to the front). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open PDFs from file managers, email, Drive, etc. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Open PDFs downloaded / linked from a browser -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Receive a PDF shared TO Sheaf -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Receive a photo / picture shared TO Sheaf: it becomes a PDF to sign and share.
                 Share-only (no VIEW), so Sheaf never offers itself as an image viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
